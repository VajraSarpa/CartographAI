# Written by `pnpm env:setup` in the app folder. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cartograph
LANGSMITH_TRACING=true
# Where the agent's tools call the app (local dev: http://localhost:3000)
CARTOGRAPH_APP_URL=http://localhost:3000

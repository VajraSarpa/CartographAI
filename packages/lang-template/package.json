{
  "name": "cartograph-lang-template",
  "version": "0.0.0",
  "private": true,
  "description": "Starting point for a Cartograph language plug-in. Copy this folder, rename it cartograph-lang-<your-language>.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "cartograph-lang-api": "workspace:*",
    "typescript": "~5.9.3"
  }
}
